<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600" prefWidth="800" style="-fx-background-color: #f0f4f7;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" >

    <!-- Top Section: Navigation Bar -->
    <top>
        <AnchorPane prefHeight="42.0" style="-fx-background-color: #3F51B5;">
        <children>
            <!-- Styled label, aligned left -->
            <Label style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;" text="EVENT PLANNER'S DASHBOARD" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="5.0" />

            <!-- Styled toolbar, aligned right -->
            <ToolBar style="-fx-background-color: transparent;" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="0.0">
                <items>
                    <Button style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="Home" />
                    <Button style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="History" />
                    <Button style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="Saved Preferences" />
                    <Button style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="About" />
                </items>
            </ToolBar>
        </children>
    </AnchorPane>
    </top>

    <!-- Main Section: Central Content -->
    <!-- Central Content -->
    <center>
    <VBox spacing="20" style="-fx-padding: 15;">
        
        <!-- Top Row: Weather Forecast and Air Quality Visualization -->
        <HBox spacing="20" />

        <!-- Bottom Row: Weather Data Visualization and Calendar -->
        <HBox spacing="20" />
         <VBox prefHeight="492.0" prefWidth="770.0">
            <children>
               <HBox prefHeight="171.0" prefWidth="770.0" style="-fx-spacing: 40; -fx-alignment: CENRER; -fx-padding: 10;">
                  <children>
                     <VBox alignment="CENTER" prefHeight="150.0" prefWidth="223.0" 
                           style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #f5f5f5, #e2e2e2); 
                                  -fx-border-radius: 10px; -fx-border-color: #dcdcdc; -fx-border-width: 1px;">
                        <children>
                            <!-- Temperature Label -->
                            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="22°C" />
                            <!-- Weather Icon -->
                            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" 
                         />
                            <!-- Location Label -->
                            <Label alignment="BOTTOM_RIGHT" 
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-label-padding: 5; -fx-text-fill: #555555;" text="Helsinki, Finland ">
                                <font>
                                    <Font size="14.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                     <VBox alignment="CENTER" prefHeight="150.0" prefWidth="223.0" 
                           style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #f5f5f5, #e2e2e2); 
                                  -fx-border-radius: 10px; -fx-border-color: #dcdcdc; -fx-border-width: 1px;">
                        <children>
                            <!-- Temperature Label -->
                            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="22°C" />
                            <!-- Weather Icon -->
                            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" 
                         />
                            <!-- Location Label -->
                            <Label alignment="BOTTOM_RIGHT" 
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-label-padding: 5; -fx-text-fill: #555555;" text="Helsinki, Finland ">
                                <font>
                                    <Font size="14.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>

                     <VBox alignment="CENTER" prefHeight="150.0" prefWidth="223.0" 
                           style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #f5f5f5, #e2e2e2); 
                                  -fx-border-radius: 10px; -fx-border-color: #dcdcdc; -fx-border-width: 1px;">
                        <children>
                            <!-- Temperature Label -->
                            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="22°C" />
                            <!-- Weather Icon -->
                            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" 
                         />
                            <!-- Location Label -->
                            <Label alignment="BOTTOM_RIGHT" 
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-label-padding: 5; -fx-text-fill: #555555;" text="Helsinki, Finland ">
                                <font>
                                    <Font size="14.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>                  </children>
               </HBox>
               <VBox prefHeight="286.0" prefWidth="770.0" style="-fx-spacing: 10; -fx-spacing: 10;">
                  <children>
                     <HBox alignment="CENTER_RIGHT" prefHeight="39.0" prefWidth="770.0" style="-fx-spacing: 10; -fx-padding: 10;">
                        <children>
                           <Button mnemonicParsing="false" style="-fx-padding: 5;" text="Search" />
                           <TextField promptText="Search city" style="-fx-padding: 5; -fx-pref-width: 200;" />
                           <Button mnemonicParsing="false" style="-fx-padding: 5;" text="Refresh" />
                        </children>
                     </HBox>
                     <TableView id="calendarTable" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: white; -fx-pref-height: 300; -fx-pref-width: 600;">
                       <columns>
                         <TableColumn prefWidth="75.0" text="City">
                              <graphic>
                                 <CheckBox mnemonicParsing="false" />
                              </graphic>
                           </TableColumn>
                         <TableColumn prefWidth="75.0" text="Date" />
                           <TableColumn prefWidth="75.0" text="Temperature" />
                           <TableColumn prefWidth="75.0" text="Air Quality" />
                       </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </children>
               </VBox>
            </children>
         </VBox>
    </VBox>
</center>
</BorderPane>