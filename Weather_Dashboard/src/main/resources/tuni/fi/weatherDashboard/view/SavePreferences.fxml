<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tuni.fi.weatherDashboard.controller.SavePreferencesController">
    <children>
        <HBox prefHeight="42.0" prefWidth="600.0">
            <children>
                <VBox prefHeight="42.0" prefWidth="297.0">
                    <children>
                        <Label text="EVENT PLANNER'S DASHBOARD" />
                    </children>
                </VBox>
                <ToolBar nodeOrientation="LEFT_TO_RIGHT" prefHeight="37.0" prefWidth="323.0">
                    <items>
                        <Button fx:id="homeButton" mnemonicParsing="false" text="Home" />
                        <Button fx:id="historyButton" mnemonicParsing="false" text="History" />
                        <Button fx:id="savedPreferencesButton" mnemonicParsing="false" text="Saved Preferences" />
                        <Button fx:id="aboutButton" mnemonicParsing="false" text="About" />
                    </items>
                </ToolBar>
            </children>
        </HBox>

        <!-- Saved Preferences Grid -->
        <GridPane fx:id="preferencesGrid" gridLinesVisible="true" layoutX="149.0" layoutY="68.0"
                  prefHeight="303.0" prefWidth="423.0" vgap="10" hgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <!-- Empty placeholders for weather data -->
            <Label fx:id="location1Label" GridPane.columnIndex="0" GridPane.rowIndex="0" text="Location 1" />
            <Label fx:id="location2Label" GridPane.columnIndex="1" GridPane.rowIndex="0" text="Location 2" />
            <Label fx:id="location3Label" GridPane.columnIndex="0" GridPane.rowIndex="1" text="Location 3" />
            <Label fx:id="location4Label" GridPane.columnIndex="1" GridPane.rowIndex="1" text="Location 4" />
            <Label fx:id="location5Label" GridPane.columnIndex="0" GridPane.rowIndex="2" text="Location 5" />
            <Label fx:id="location6Label" GridPane.columnIndex="1" GridPane.rowIndex="2" text="Location 6" />
        </GridPane>


        <!-- Saved Locations Section -->
        <VBox layoutX="14.0" layoutY="68.0" prefHeight="322.0" prefWidth="96.0" spacing="10.0">
            <children>
                <Label text="Saved Locations" />
                <ListView fx:id="savedLocationsList" VBox.vgrow="ALWAYS" />
                <Button fx:id="removeButton" text="Remove Selected" />
                <Button fx:id="clearAllButton" text="Clear All" />
            </children>
        </VBox>
    </children>
</AnchorPane>
