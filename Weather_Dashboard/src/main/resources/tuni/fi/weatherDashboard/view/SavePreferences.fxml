<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Top Navigation Bar -->
        <HBox prefHeight="42.0" prefWidth="800.0">
            <children>
                <Label text="EVENT PLANNER'S DASHBOARD" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <ToolBar nodeOrientation="LEFT_TO_RIGHT" prefHeight="37.0" prefWidth="500.0">
                    <items>
                        <Button fx:id="homeButton" mnemonicParsing="false" text="Home" />
                        <Button fx:id="historyButton" mnemonicParsing="false" text="History" />
                        <Button fx:id="savedPreferencesButton" mnemonicParsing="false" text="Saved Preferences" />
                        <Button fx:id="aboutButton" mnemonicParsing="false" text="About" />
                    </items>
                </ToolBar>
            </children>
        </HBox>

        <!-- Scrollable Grid for Weather Preferences -->
        <ScrollPane layoutX="149.0" layoutY="120.0" prefHeight="303.0" prefWidth="500.0">
            <content>
                <GridPane fx:id="preferencesGrid" gridLinesVisible="false">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="150.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="150.0" prefHeight="150.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="150.0" prefHeight="150.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="150.0" prefHeight="150.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                </GridPane>
            </content>
        </ScrollPane>

        <!-- Saved Locations Section -->
        <VBox layoutX="14.0" layoutY="68.0" prefHeight="322.0" prefWidth="96.0" spacing="10.0">
            <children>
                <Label text="Saved Locations" />
                <ListView fx:id="savedLocationsList" VBox.vgrow="ALWAYS" />
                <Button fx:id="removeButton" text="Remove Selected" onAction="#removeSelectedLocation"/>
                <Button fx:id="clearAllButton" text="Clear All" onAction="#removeAllLocations"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
