<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="600" prefWidth="800" style="-fx-background-color: #f0f4f7;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" >

     <!-- Top Section -->
    <top>
        <AnchorPane prefHeight="42.0" style="-fx-background-color: #3F51B5;">
            <children>
                <Label style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;" 
                       text="EVENT PLANNER'S DASHBOARD" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="5.0" />
                <ToolBar style="-fx-background-color: transparent;" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="0.0">
                    <items>
                        <Button fx:id="homeButton" style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="Home" />
                        <Button fx:id="historyButton" style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="History" />
                        <Button fx:id="savedPreferencesButton" style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="Saved Preferences" />
                        <Button fx:id="aboutButton" style="-fx-background-color: #3F51B5; -fx-text-fill: white;" text="About" />
                    </items>
                </ToolBar>
            </children>
        </AnchorPane>
    </top>

    <center>
       <AnchorPane prefHeight="700.0" prefWidth="800.0">
    <children>
        <!-- Horizontal Box to align the Scrollable Grid and Saved Locations Section -->
        <HBox layoutX="14.0" layoutY="70.0" spacing="20.0">
            <children>
                <!-- Saved Locations Section -->
                <VBox prefHeight="450.0" prefWidth="150.0" spacing="10.0">
                    <children>
                        <Label text="Saved Locations" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <ListView fx:id="savedLocationsList" VBox.vgrow="ALWAYS" />
                        <Button fx:id="removeButton" text="Remove Selected" onAction="#removeSelectedLocation" />
                        <Button fx:id="clearAllButton" text="Clear All" onAction="#removeAllLocations" />
                    </children>
                </VBox>

                <!-- Scrollable Grid for Weather Preferences -->
                <ScrollPane prefHeight="303.0" prefWidth="580.0">
                    <content>
                        <GridPane fx:id="preferencesGrid" gridLinesVisible="false" hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="150.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="150.0" prefHeight="150.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="150.0" prefHeight="150.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="150.0" prefHeight="150.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                        </GridPane>
                    </content>
                </ScrollPane>
            </children>
        </HBox>
    </children>
</AnchorPane>
    </center>
</BorderPane>
